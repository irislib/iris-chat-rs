<UserControl x:Class="IrisChat.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:chrome="clr-namespace:IrisChat.Chrome"
             xmlns:views="clr-namespace:IrisChat.Views"
             Foreground="{StaticResource TextPrimary}" SizeChanged="OnSettingsSizeChanged">
    <UserControl.Resources>
        <ResourceDictionary Source="SettingsStyles.xaml" />
    </UserControl.Resources>
    <Grid Background="{StaticResource Background}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <StackPanel Orientation="Horizontal" Margin="12,12,12,8">
            <Button x:Name="BackButton" Style="{StaticResource SettingsButton}" Click="OnBack"
                   AutomationProperties.Name="Back" ToolTip="Back" Width="36" Padding="8">
                <TextBlock Text="&#xE72B;" FontFamily="Segoe MDL2 Assets" FontSize="16" />
            </Button>
            <TextBlock Text="Settings" FontSize="20" FontWeight="SemiBold"
                       VerticalAlignment="Center" Margin="16,0,0,0" />
        </StackPanel>
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="NavigationColumn" Width="240" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <ListBox x:Name="SettingsNavigation" Margin="8,8,0,8" BorderThickness="0"
                     Background="Transparent" Foreground="{StaticResource TextPrimary}"
                     ItemContainerStyle="{StaticResource SettingsNavigationItem}"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                     ScrollViewer.VerticalScrollBarVisibility="Auto"
                     ScrollViewer.CanContentScroll="False"
                     KeyboardNavigation.TabNavigation="Once"
                    AutomationProperties.Name="Settings categories"
                     SelectionChanged="OnSettingsSelectionChanged">
                <ListBox.Template>
                    <ControlTemplate TargetType="ListBox">
                        <ScrollViewer Style="{StaticResource SettingsScrollViewer}"
                                      VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                            <ItemsPresenter />
                        </ScrollViewer>
                    </ControlTemplate>
                </ListBox.Template>
                <ListBoxItem Tag="Profile" ToolTip="Profile" AutomationProperties.Name="Profile">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xEA8C;" Style="{StaticResource SettingsNavigationIcon}" />
                        <TextBlock Text="Profile" Style="{StaticResource SettingsNavigationLabel}" />
                    </StackPanel>
                </ListBoxItem>
                <ListBoxItem Tag="General" ToolTip="General" AutomationProperties.Name="General">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE713;" Style="{StaticResource SettingsNavigationIcon}" />
                        <TextBlock Text="General" Style="{StaticResource SettingsNavigationLabel}" />
                    </StackPanel>
                </ListBoxItem>
                <ListBoxItem Tag="Notifications" ToolTip="Notifications" AutomationProperties.Name="Notifications">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xEA8F;" Style="{StaticResource SettingsNavigationIcon}" />
                        <TextBlock Text="Notifications" Style="{StaticResource SettingsNavigationLabel}" />
                    </StackPanel>
                </ListBoxItem>
                <ListBoxItem Tag="Messaging" ToolTip="Messaging" AutomationProperties.Name="Messaging">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE8F2;" Style="{StaticResource SettingsNavigationIcon}" />
                        <TextBlock Text="Messaging" Style="{StaticResource SettingsNavigationLabel}" />
                    </StackPanel>
                </ListBoxItem>
                <ListBoxItem Tag="Nearby" ToolTip="Nearby" AutomationProperties.Name="Nearby">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE701;" Style="{StaticResource SettingsNavigationIcon}" />
                        <TextBlock Text="Nearby" Style="{StaticResource SettingsNavigationLabel}" />
                    </StackPanel>
                </ListBoxItem>
                <ListBoxItem Tag="Devices" ToolTip="Devices" AutomationProperties.Name="Devices">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE772;" Style="{StaticResource SettingsNavigationIcon}" />
                        <TextBlock Text="Devices" Style="{StaticResource SettingsNavigationLabel}" />
                    </StackPanel>
                </ListBoxItem>
                <ListBoxItem Tag="Security" ToolTip="Keys" AutomationProperties.Name="Keys">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE72E;" Style="{StaticResource SettingsNavigationIcon}" />
                        <TextBlock Text="Keys" Style="{StaticResource SettingsNavigationLabel}" />
                    </StackPanel>
                </ListBoxItem>
                <ListBoxItem Tag="Updates" ToolTip="Updates" AutomationProperties.Name="Updates" Margin="4,14,4,2">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE895;" Style="{StaticResource SettingsNavigationIcon}" />
                        <TextBlock Text="Updates" Style="{StaticResource SettingsNavigationLabel}" />
                    </StackPanel>
                </ListBoxItem>
                <ListBoxItem Tag="Support" ToolTip="Support" AutomationProperties.Name="Support">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE897;" Style="{StaticResource SettingsNavigationIcon}" />
                        <TextBlock Text="Support" Style="{StaticResource SettingsNavigationLabel}" />
                    </StackPanel>
                </ListBoxItem>
                <ListBoxItem Tag="About" ToolTip="About" AutomationProperties.Name="About">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE946;" Style="{StaticResource SettingsNavigationIcon}" />
                        <TextBlock Text="About" Style="{StaticResource SettingsNavigationLabel}" />
                    </StackPanel>
                </ListBoxItem>
                <ListBoxItem Tag="AccountData" ToolTip="Account data" AutomationProperties.Name="Account data">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE8D4;" Style="{StaticResource SettingsNavigationIcon}" />
                        <TextBlock Text="Account data" Style="{StaticResource SettingsNavigationLabel}" />
                    </StackPanel>
                </ListBoxItem>
                <ListBoxItem Tag="Media" ToolTip="Media" AutomationProperties.Name="Media" Margin="4,14,4,2">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xEB9F;" Style="{StaticResource SettingsNavigationIcon}" />
                        <TextBlock Text="Media" Style="{StaticResource SettingsNavigationLabel}" />
                    </StackPanel>
                </ListBoxItem>
                <ListBoxItem Tag="MessageServers" ToolTip="Message servers" AutomationProperties.Name="Message servers">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE968;" Style="{StaticResource SettingsNavigationIcon}" />
                        <TextBlock Text="Message servers" Style="{StaticResource SettingsNavigationLabel}" />
                    </StackPanel>
                </ListBoxItem>
            </ListBox>
            <ScrollViewer x:Name="PageScroll" Style="{StaticResource SettingsScrollViewer}" Grid.Column="1" VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled" Focusable="False">
                <StackPanel x:Name="PageContent" Margin="32,20,32,32" MaxWidth="960" HorizontalAlignment="Stretch">
                    <TextBlock x:Name="PageTitle" FontSize="28" FontWeight="SemiBold" Margin="0,0,0,24" TextWrapping="Wrap" />
                <Border x:Name="ProfilePage" Style="{StaticResource SettingsCard}">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,20">
                            <chrome:Avatar x:Name="ProfileAvatar" Size="64" />
                            <StackPanel Margin="16,0,0,0" VerticalAlignment="Center">
                                <Button Style="{StaticResource SettingsButton}" Click="OnPickPicture" Content="Change picture" />
                                <TextBlock x:Name="NpubText" Style="{StaticResource MutedText}" Margin="0,6,0,0" />
                            </StackPanel>
                        </StackPanel>
                        <TextBlock Text="Name" Margin="0,0,0,6" />
                        <TextBox x:Name="ProfileNameInput" AutomationProperties.Name="Name" />

                        <TextBlock Text="About"
                                   Style="{StaticResource MutedText}"
                                   Margin="0,16,0,6" />
                        <TextBox x:Name="ProfileAboutInput" AutomationProperties.Name="About"
                                 AcceptsReturn="True"
                                 TextWrapping="Wrap"
                                 MinHeight="76"
                                 VerticalScrollBarVisibility="Auto" />

                        <Button x:Name="SaveProfileButton" Style="{StaticResource SettingsPrimaryButton}" Click="OnSaveProfile"
                                Content="Save" MinWidth="96" HorizontalAlignment="Left" Margin="0,16,0,0" />

                        <Button Style="{StaticResource SettingsButton}"
                                Click="OnNoteToSelf"
                                AutomationProperties.AutomationId="myProfileNoteToSelfButton"
                                HorizontalAlignment="Left" Margin="0,16,0,0">
                            <TextBlock Text="Note to self" />
                        </Button>

                        <WrapPanel Margin="0,16,0,0">
                            <Button Style="{StaticResource SettingsButton}"
                                    Click="OnCopyUserId"
                                    HorizontalAlignment="Left"
                                    Margin="0,0,8,0">
                                <TextBlock Text="Copy user ID" />
                            </Button>
                            <Button Style="{StaticResource SettingsButton}"
                                    Click="OnToggleProfileQr"
                                    HorizontalAlignment="Left">
                                <TextBlock Text="Code" />
                            </Button>
                        </WrapPanel>

                        <Border x:Name="ProfileQrPanel"
                                Background="{StaticResource PanelAlt}"
                                CornerRadius="6"
                                Padding="20"
                                MaxWidth="296"
                                HorizontalAlignment="Left"
                                Margin="0,18,0,0"
                                Visibility="Collapsed">
                            <StackPanel HorizontalAlignment="Center">
                                <Viewbox StretchDirection="DownOnly">
                                    <chrome:QrCodeView x:Name="ProfileQr" Width="216" Height="216" />
                                </Viewbox>
                                <Button Style="{StaticResource SettingsButton}"
                                        Click="OnCopyProfileLink"
                                        Margin="0,8,0,0"
                                        HorizontalAlignment="Center">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="Copy"
                                                   Margin="0,0,6,0" />
                                        <TextBlock x:Name="ProfileQrName"
                                                   FontWeight="SemiBold" />
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Border>

                <Border x:Name="DevicesPage">
                    <views:DeviceRosterView IsEmbedded="True" />
                </Border>

                <Border x:Name="GeneralPage">
                    <StackPanel>
                        <CheckBox x:Name="StartupToggle"
                                  AutomationProperties.AutomationId="startupAtLoginToggle"
                                  Checked="OnStartupChanged"
                                  Unchecked="OnStartupChanged" AutomationProperties.Name="Start at login">
                            <TextBlock Text="Start at login" TextWrapping="Wrap" />
                        </CheckBox>
                        <Border Style="{StaticResource SettingsCard}" Margin="0,8,0,0">
                            <StackPanel>
                                <TextBlock Text="Appearance" Style="{StaticResource SectionTitleText}" />
                                <TextBlock Text="Iris Chat uses your Windows app mode." TextWrapping="Wrap"
                                           Foreground="{StaticResource TextMuted}" Margin="0,6,0,12" />
                                <Button Style="{StaticResource SettingsButton}" Content="Windows color settings"
                                        Click="OnWindowsColors" HorizontalAlignment="Left" />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Border>

                <Border x:Name="MessagingPage">
                    <StackPanel>
                        <CheckBox x:Name="AcceptChatRequestsToggle"
                                  Checked="OnAcceptChatRequestsChanged" Unchecked="OnAcceptChatRequestsChanged" AutomationProperties.Name="Accept chat requests">
                            <TextBlock Text="Accept chat requests" TextWrapping="Wrap" />
                        </CheckBox>
                        <CheckBox x:Name="TypingToggle"
                                  Checked="OnTypingChanged" Unchecked="OnTypingChanged" AutomationProperties.Name="Typing indicators">
                            <TextBlock Text="Typing indicators" TextWrapping="Wrap" />
                        </CheckBox>
                        <CheckBox x:Name="ReceiptsToggle"
                                  Checked="OnReceiptsChanged" Unchecked="OnReceiptsChanged" AutomationProperties.Name="Read receipts">
                            <TextBlock Text="Read receipts" TextWrapping="Wrap" />
                        </CheckBox>
                        <CheckBox x:Name="HideBlockedGroupMessagesToggle"
                                  Checked="OnHideBlockedGroupMessagesChanged" Unchecked="OnHideBlockedGroupMessagesChanged" AutomationProperties.Name="Hide past group messages from blocked people">
                            <TextBlock Text="Hide past group messages from blocked people" TextWrapping="Wrap" />
                        </CheckBox>
                        <CheckBox x:Name="AllowMessageDeletionToggle"
                                  Checked="OnAllowMessageDeletionChanged" Unchecked="OnAllowMessageDeletionChanged" AutomationProperties.Name="Allow others to delete their messages">
                            <TextBlock Text="Allow others to delete their messages" TextWrapping="Wrap" />
                        </CheckBox>
                        <TextBlock Text="Blocked people" Style="{StaticResource SectionTitleText}" Margin="0,20,0,8" />
                        <StackPanel x:Name="BlockedPeopleList" />
                    </StackPanel>
                </Border>

                <Border x:Name="NotificationsPage">
                    <StackPanel>
                        <CheckBox x:Name="NotificationsToggle"
                                  Checked="OnNotificationsChanged" Unchecked="OnNotificationsChanged" AutomationProperties.Name="Show notifications">
                            <TextBlock Text="Show notifications" TextWrapping="Wrap" />
                        </CheckBox>
                    </StackPanel>
                </Border>

                <Border x:Name="MediaPage" Style="{StaticResource SettingsCard}">
                    <StackPanel>
                        <CheckBox x:Name="ImageProxyToggle"
                                  Checked="OnImageProxyChanged" Unchecked="OnImageProxyChanged" AutomationProperties.Name="Image proxy">
                            <TextBlock Text="Image proxy" TextWrapping="Wrap" />
                        </CheckBox>
                        <CheckBox x:Name="ImageProxyFallbackToggle" AutomationProperties.Name="Load original images if the proxy fails" Margin="0,0,0,12"
                                  Checked="OnImageProxyFallbackChanged" Unchecked="OnImageProxyFallbackChanged">
                            <StackPanel>
                                <TextBlock Text="Load original images if the proxy fails" TextWrapping="Wrap" />
                                <TextBlock Text="Image hosts may see your IP address."
                                           Style="{StaticResource MutedText}" TextWrapping="Wrap" Margin="0,4,0,0" />
                            </StackPanel>
                        </CheckBox>
                        <TextBlock Text="Proxy URL" Style="{StaticResource MutedText}" Margin="0,0,0,4" />
                        <TextBox x:Name="ImageProxyUrlInput" LostFocus="OnImageProxyUrlCommitted" Margin="0,0,0,10" />
                        <TextBlock Text="Proxy key" Style="{StaticResource MutedText}" Margin="0,0,0,4" />
                        <TextBox x:Name="ImageProxyKeyInput" LostFocus="OnImageProxyKeyCommitted" Margin="0,0,0,10" />
                        <TextBlock Text="Proxy salt" Style="{StaticResource MutedText}" Margin="0,0,0,4" />
                        <TextBox x:Name="ImageProxySaltInput" LostFocus="OnImageProxySaltCommitted" Margin="0,0,0,12" />
                        <Button Style="{StaticResource SettingsButton}"
                                Click="OnResetImageProxy"
                                HorizontalAlignment="Left">
                            <TextBlock Text="Reset image proxy" />
                        </Button>
                    </StackPanel>
                </Border>

                <Border x:Name="NearbyPage">
                    <StackPanel>
                        <CheckBox x:Name="NearbyEnabledToggle"
                                  Checked="OnNearbyEnabledChanged"
                                  Unchecked="OnNearbyEnabledChanged"
                                  AutomationProperties.Name="Nearby">
                            <TextBlock Text="Nearby" TextWrapping="Wrap" />
                        </CheckBox>
                        <CheckBox x:Name="NearbyLanToggle"
                                  Checked="OnNearbyLanChanged"
                                  Unchecked="OnNearbyLanChanged"
                                  AutomationProperties.Name="Wi-Fi">
                            <TextBlock Text="Wi-Fi" TextWrapping="Wrap" />
                        </CheckBox>
                        <CheckBox x:Name="NearbyShowInChatListToggle"
                                  Checked="OnNearbyShowInChatListChanged"
                                  Unchecked="OnNearbyShowInChatListChanged" AutomationProperties.Name="Show in chat list">
                            <TextBlock Text="Show in chat list" TextWrapping="Wrap" />
                        </CheckBox>
                    </StackPanel>
                </Border>

                <Border x:Name="MessageServersPage" Style="{StaticResource SettingsCard}">
                    <StackPanel>
                        <ItemsControl x:Name="RelaysList" />
                        <TextBlock Text="Server address" Margin="0,12,0,6" />
                        <TextBox x:Name="NewRelayInput" AutomationProperties.Name="Server address" />
                        <WrapPanel Margin="0,12,0,0">
                            <Button Style="{StaticResource SettingsButton}" Click="OnAddRelay" Content="Add" Margin="0,0,8,8" />
                            <Button Style="{StaticResource SettingsButton}" Click="OnResetRelays" Content="Reset" Margin="0,0,0,8" />
                        </WrapPanel>
                    </StackPanel>
                </Border>

                <Border x:Name="SecurityPage" Style="{StaticResource SettingsCard}">
                    <StackPanel>
                        <Button x:Name="ExportOwnerKeyButton"
                                Style="{StaticResource SettingsButton}"
                                Click="OnExportOwner"
                                HorizontalAlignment="Left">
                            <TextBlock Text="Copy secret key" />
                        </Button>
                    </StackPanel>
                </Border>

                <Border x:Name="UpdatesPage">
                    <StackPanel>
                        <TextBlock x:Name="UpdateVersionText" TextWrapping="Wrap"
                                   Foreground="{StaticResource TextPrimary}"
                                   Margin="0,0,0,8" />
                        <CheckBox x:Name="AutoCheckUpdatesToggle"

                                  Checked="OnAutoCheckUpdatesChanged"
                                  Unchecked="OnAutoCheckUpdatesChanged" AutomationProperties.Name="Check automatically">
                            <TextBlock Text="Check automatically" TextWrapping="Wrap" />
                        </CheckBox>
                        <CheckBox x:Name="AutoInstallUpdatesToggle"

                                  Checked="OnAutoInstallUpdatesChanged"
                                  Unchecked="OnAutoInstallUpdatesChanged" AutomationProperties.Name="Install automatically">
                            <TextBlock Text="Install automatically" TextWrapping="Wrap" />
                        </CheckBox>
                        <WrapPanel>
                            <Button x:Name="CheckUpdatesButton"
                                    Style="{StaticResource SettingsButton}"
                                    Click="OnCheckUpdates"
                                    Margin="0,0,8,8">
                                <TextBlock Text="Check for updates" />
                            </Button>
                            <Button x:Name="InstallUpdateButton"
                                    Style="{StaticResource SettingsPrimaryButton}"
                                    Click="OnInstallUpdate" Margin="0,0,0,8">
                                <TextBlock Text="Install update" />
                            </Button>
                        </WrapPanel>
                        <TextBlock x:Name="UpdateStatusText" TextWrapping="Wrap"
                                   Style="{StaticResource MutedText}"
                                   Margin="0,10,0,0" />
                    </StackPanel>
                </Border>

                <Border x:Name="AboutPage" Style="{StaticResource SettingsCard}">
                    <StackPanel>
                        <TextBlock x:Name="VersionText" TextWrapping="Wrap"
                                   Foreground="{StaticResource TextPrimary}"
                                   Margin="0,0,0,4" />
                        <TextBlock x:Name="RelaySetText"
                                   Style="{StaticResource MutedText}" />
                        <TextBlock x:Name="NetworkText" TextWrapping="Wrap"
                                   Style="{StaticResource MutedText}"
                                   Margin="0,4,0,0" />
                        <Button Style="{StaticResource SettingsButton}"
                                Click="OnSourceCode"
                                Margin="0,12,0,0"
                                HorizontalAlignment="Left">
                            <TextBlock Text="Source code" />
                        </Button>
                    </StackPanel>
                </Border>

                <Border x:Name="SupportPage" Style="{StaticResource SettingsCard}">
                    <StackPanel>
                        <Button Style="{StaticResource SettingsButton}"
                                Click="OnExportSupport"
                                HorizontalAlignment="Left">
                            <TextBlock Text="Save support bundle" />
                        </Button>
                    </StackPanel>
                </Border>

                <Border x:Name="AccountDataPage" Style="{StaticResource SettingsCard}">
                    <StackPanel>
                        <Button Style="{StaticResource SettingsDangerButton}"
                                Click="OnLogout"
                                HorizontalAlignment="Left">
                            <TextBlock Text="Log out" />
                        </Button>
                    </StackPanel>
                </Border>

                </StackPanel>
            </ScrollViewer>
        </Grid>
    </Grid>
</UserControl>
