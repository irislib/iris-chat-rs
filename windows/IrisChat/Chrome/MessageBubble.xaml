<UserControl x:Class="IrisChat.Chrome.MessageBubble"
             x:Name="RootBubble"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.ContextMenu>
        <ContextMenu>
            <MenuItem Header="Copy" Click="OnCopyText" />
            <MenuItem Header="Info" Click="OnShowInfo" />
        </ContextMenu>
    </UserControl.ContextMenu>
    <Border x:Name="Bubble"
            CornerRadius="18"
            Padding="12,8"
            Margin="0,6"
            MaxWidth="540">
        <StackPanel>
            <TextBlock x:Name="AuthorText"
                       Foreground="{Binding Foreground, ElementName=RootBubble}"
                       FontSize="11"
                       Margin="0,0,0,2"
                       Visibility="Collapsed" />
            <RichTextBox x:Name="BodyText"
                     Foreground="{Binding Foreground, ElementName=RootBubble}"
                     FontSize="14"
                     IsDocumentEnabled="True"
                     IsReadOnly="True"
                     IsTabStop="False"
                     BorderThickness="0"
                     Padding="0"
                     Background="Transparent"
                     HorizontalScrollBarVisibility="Disabled"
                     VerticalScrollBarVisibility="Disabled" />
            <Button x:Name="SystemNoticeProfile" Visibility="Collapsed"
                    Click="OnOpenSystemNoticeProfile" ToolTip="Open profile" Cursor="Hand"
                    Background="Transparent" BorderThickness="0" Padding="0">
                <TextBlock x:Name="SystemNoticeProfileText" TextWrapping="Wrap"
                           TextAlignment="Center" Foreground="{StaticResource TextMuted}" />
            </Button>
            <!-- All bubble content follows its direction-specific foreground. -->
            <TextBlock x:Name="ShowMoreLink"
                       Visibility="Collapsed"
                       Foreground="{Binding Foreground, ElementName=RootBubble}"
                       FontSize="12"
                       FontWeight="SemiBold"
                       Margin="0,4,0,0"
                       Cursor="Hand"
                       MouseLeftButtonUp="OnToggleShowMore"
                       Text="Show more" />
            <ContentControl x:Name="DirectTransfer" Visibility="Collapsed" Margin="0,4,0,0" />
            <ItemsControl x:Name="AttachmentsList"
                          Visibility="Collapsed"
                          Margin="0,4,0,0" />
            <StackPanel x:Name="MetaRow"
                        Orientation="Horizontal"
                        HorizontalAlignment="Right"
                        Margin="0,4,0,0">
                <TextBlock x:Name="TimeText"
                           Foreground="{Binding Foreground, ElementName=RootBubble}"
                           FontSize="10" />
                <Button x:Name="EditedButton" Content="Edited" Visibility="Collapsed"
                        Click="OnShowEditHistory" Background="Transparent" BorderThickness="0" Cursor="Hand"
                        Foreground="{Binding Foreground, ElementName=RootBubble}" FontSize="10" Padding="0"
                        Margin="6,0,0,0" ToolTip="Edit history" />
                <TextBlock x:Name="DeliveryText"
                           Foreground="{Binding Foreground, ElementName=RootBubble}"
                           FontSize="10"
                           Margin="6,0,0,0" />
            </StackPanel>
        </StackPanel>
    </Border>
</UserControl>
