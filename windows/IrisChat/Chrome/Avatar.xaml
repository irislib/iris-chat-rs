<UserControl x:Class="IrisChat.Chrome.Avatar"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Width="44" Height="44">
    <Grid>
        <Border x:Name="BackgroundBorder"
                CornerRadius="22"
                Background="{StaticResource Accent}" />
        <TextBlock x:Name="Initials"
                   Foreground="White"
                   FontSize="16"
                   FontWeight="SemiBold"
                   HorizontalAlignment="Center"
                   VerticalAlignment="Center" />
        <Border x:Name="ImageHost"
                CornerRadius="22"
                Visibility="Collapsed"
                ClipToBounds="True">
            <Border.Background>
                <ImageBrush x:Name="ImageBrush" Stretch="UniformToFill" />
            </Border.Background>
        </Border>
        <Border x:Name="SocialMark" Width="16" Height="16" CornerRadius="8"
                HorizontalAlignment="Right" VerticalAlignment="Top" Visibility="Collapsed">
            <TextBlock x:Name="SocialMarkText" Foreground="White" FontSize="12" FontWeight="Bold"
                       HorizontalAlignment="Center" VerticalAlignment="Center" />
        </Border>
        <Border x:Name="NearbyMark" Width="16" Height="16" CornerRadius="8"
                HorizontalAlignment="Right" VerticalAlignment="Bottom" Visibility="Collapsed"
                Background="#2267F5" BorderBrush="{StaticResource Background}" BorderThickness="2"
                ToolTip="Nearby" AutomationProperties.Name="Nearby">
            <TextBlock x:Name="NearbyMarkIcon" Text="&#xE701;" FontFamily="Segoe MDL2 Assets"
                       Foreground="White" FontSize="10" HorizontalAlignment="Center" VerticalAlignment="Center" />
        </Border>
    </Grid>
</UserControl>
