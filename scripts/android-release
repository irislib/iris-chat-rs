#!/usr/bin/env bash

set -Eeuo pipefail

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
# shellcheck disable=SC1091
source "$ROOT/scripts/build_common.sh"

load_release_env "$ROOT"
resolve_shared_build_metadata "$ROOT"

ANDROID_DIR="$ROOT/android"
ANDROID_DIST_DIR="$ROOT/dist/android"
RELEASE_TASKS=(:app:bundleRelease :app:assembleSelfHosted)

usage() {
  cat <<'EOF'
usage: ./scripts/android-release <print-config|beta-apk|beta-bundle|release-apk|release-bundle|release-preflight|release-artifacts>
EOF
}

ensure_local_properties() {
  if [[ ! -f "$ANDROID_DIR/local.properties" ]]; then
    "$ROOT/scripts/android-build" android-local-properties || true
  fi
}

print_config() {
  cat <<EOF
android.dir=$ANDROID_DIR
app.version.name=$IRIS_APP_VERSION_NAME
app.version.code=$IRIS_APP_VERSION_CODE
build.git.sha=$IRIS_BUILD_GIT_SHA
build.timestamp.utc=$IRIS_BUILD_TIMESTAMP_UTC
debug.relay.set.id=${IRIS_DEBUG_RELAY_SET_ID:-public-dev}
beta.relay.set.id=${IRIS_BETA_RELAY_SET_ID:-beta-fallback}
release.relay.set.id=${IRIS_RELEASE_RELAY_SET_ID:-public-release}
beta.signing.configured=$([[ -n "${IRIS_BETA_KEYSTORE_PATH:-}" && -n "${IRIS_BETA_KEY_ALIAS:-}" ]] && printf true || printf false)
release.signing.configured=$([[ -n "${IRIS_RELEASE_KEYSTORE_PATH:-}" && -n "${IRIS_RELEASE_KEY_ALIAS:-}" ]] && printf true || printf false)
dist.dir=$ANDROID_DIST_DIR
EOF
}

copy_artifact() {
  local source_path="$1"
  local channel="$2"
  local extension="$3"
  local basename
  local destination
  local manifest
  local latest_destination
  local latest_manifest

  ensure_dir "$ANDROID_DIST_DIR"
  basename="$(release_slug "$channel")"
  destination="$ANDROID_DIST_DIR/${basename}.${extension}"
  manifest="$ANDROID_DIST_DIR/${basename}.env"
  latest_destination="$ANDROID_DIST_DIR/IrisChat-${channel}-latest.${extension}"
  latest_manifest="$ANDROID_DIST_DIR/IrisChat-${channel}-latest.env"

  cp "$source_path" "$destination"
  cp "$source_path" "$latest_destination"
  write_manifest "$manifest" \
    artifact_path "$destination" \
    artifact_source "$source_path" \
    build_channel "$channel" \
    app_version_name "$IRIS_APP_VERSION_NAME" \
    app_version_code "$IRIS_APP_VERSION_CODE" \
    build_git_sha "$IRIS_BUILD_GIT_SHA" \
    build_timestamp_utc "$IRIS_BUILD_TIMESTAMP_UTC"
  write_manifest "$latest_manifest" \
    artifact_path "$latest_destination" \
    artifact_source "$source_path" \
    build_channel "$channel" \
    app_version_name "$IRIS_APP_VERSION_NAME" \
    app_version_code "$IRIS_APP_VERSION_CODE" \
    build_git_sha "$IRIS_BUILD_GIT_SHA" \
    build_timestamp_utc "$IRIS_BUILD_TIMESTAMP_UTC"

  printf '%s\n' "$destination"
}

build_variant() {
  local channel="$1"
  local gradle_task="$2"
  local outputs_subdir="$3"
  local extension="$4"
  local artifact_source

  if [[ "$channel" == "release" ]]; then
    require_var IRIS_RELEASE_KEYSTORE_PATH
    require_var IRIS_RELEASE_KEYSTORE_PASSWORD
    require_var IRIS_RELEASE_KEY_ALIAS
    require_var IRIS_RELEASE_KEY_PASSWORD
  fi

  ensure_local_properties
  (
    cd "$ANDROID_DIR"
    ./gradlew ":app:${gradle_task}"
  )

  artifact_source="$(find "$ANDROID_DIR/app/build/outputs/${outputs_subdir}" -maxdepth 1 -type f -name "*.${extension}" | sort | tail -n 1)"
  if [[ -z "${artifact_source:-}" ]]; then
    echo "Android artifact was not produced in $outputs_subdir" >&2
    exit 1
  fi

  copy_artifact "$artifact_source" "$channel" "$extension"
}

latest_artifact() {
  local outputs_subdir="$1"
  local extension="$2"
  local artifact_source
  artifact_source="$(find "$ANDROID_DIR/app/build/outputs/${outputs_subdir}" -maxdepth 1 -type f -name "*.${extension}" | sort | tail -n 1)"
  if [[ -z "${artifact_source:-}" ]]; then
    echo "Android artifact was not produced in $outputs_subdir" >&2
    exit 1
  fi
  printf '%s\n' "$artifact_source"
}

release_gradle() {
  (
    cd "$ANDROID_DIR"
    # Keep configuration checks and the real build on the same launch settings.
    ./gradlew --max-workers=2 \
      '-Dorg.gradle.jvmargs=-Xmx4g -Dfile.encoding=UTF-8' \
      --dependency-verification strict \
      "$@"
  )
}

preflight_release_artifacts() {
  require_var IRIS_RELEASE_KEYSTORE_PATH
  require_var IRIS_RELEASE_KEYSTORE_PASSWORD
  require_var IRIS_RELEASE_KEY_ALIAS
  require_var IRIS_RELEASE_KEY_PASSWORD

  ensure_local_properties
  local report_dir
  mkdir -p "$ANDROID_DIR/build/reports"
  report_dir="$(mktemp -d "$ANDROID_DIR/build/reports/release-preflight.XXXXXX")"
  # Resolve real external artifacts and lazy SDK inputs before native compilation.
  IRIS_ANDROID_DEPENDENCY_PHASE=preflight \
    IRIS_ANDROID_DEPENDENCY_REPORT="$report_dir/release-inputs.json" \
    release_gradle --no-parallel --init-script "$ROOT/scripts/android-dependency-phase.init.gradle" :irisReleaseInputs
  # Exercise resource transforms for both variants. Generated Rust bindings are
  # Kotlin inputs, unnecessary here; the real build retains that dependency.
  release_gradle -x :app:generateRustBindings \
    :app:processReleaseResources :app:processSelfHostedResources
  release_gradle --dry-run "${RELEASE_TASKS[@]}"
}

build_release_artifacts() {
  preflight_release_artifacts
  release_gradle "${RELEASE_TASKS[@]}"

  copy_artifact "$(latest_artifact bundle/release aab)" release aab
  copy_artifact "$(latest_artifact apk/selfHosted apk)" release apk
}

case "${1:-}" in
  print-config)
    print_config
    ;;
  beta-apk)
    build_variant beta assembleBeta apk/beta apk
    ;;
  beta-bundle)
    build_variant beta bundleBeta bundle/beta aab
    ;;
  release-apk)
    build_variant release assembleSelfHosted apk/selfHosted apk
    ;;
  release-bundle)
    build_variant release bundleRelease bundle/release aab
    ;;
  release-artifacts)
    build_release_artifacts
    ;;
  release-preflight)
    preflight_release_artifacts
    ;;
  -h|--help|help)
    usage
    ;;
  *)
    usage >&2
    exit 2
    ;;
esac
