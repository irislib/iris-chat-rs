#!/usr/bin/env bash

set -Eeuo pipefail

ROOT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"

python3 -m unittest discover -s "$ROOT_DIR/scripts" -p 'test_*.py'

if "$ROOT_DIR/scripts/distribute" hashtree >/dev/null 2>&1; then
  echo "Distributor accepted a missing --tag." >&2
  exit 1
fi

if rg -n \
  'IRIS_RELEASE_NOSTR_KEY_PATH|HTREE_CONFIG_DIR|IrisChat-release-latest|scripts/release --publish' \
  "$ROOT_DIR/scripts/distribute" \
  "$ROOT_DIR/scripts/distribution_common.sh" \
  "$ROOT_DIR/RELEASE.md"; then
  echo "Canonical release paths contain a forbidden legacy fallback." >&2
  exit 1
fi

echo "Release publication contract passed."
