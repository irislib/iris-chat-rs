<?xml version="1.0" encoding="utf-8"?>
<!-- Account databases and encrypted secrets cannot be restored without the
     installation's Android Keystore key. Use in-app device linking instead. -->
<full-backup-content>
    <exclude domain="root" path="." />
    <exclude domain="file" path="." />
    <exclude domain="database" path="." />
    <exclude domain="sharedpref" path="." />
    <exclude domain="external" path="." />
</full-backup-content>
